# Archivo local opcional. Ejecutar con: node --env-file=.env server.cjs
PORT=4178
AUREA_DB=./data/aurea.sqlite
# Activar estas opciones al configurar el dominio HTTPS de la instalación:
# AUREA_ORIGIN=https://aurea.ejemplo.com
# AUREA_SECURE_COOKIE=1
# Definir un código privado antes de exponer el asistente de primera instalación:
# AUREA_SETUP_TOKEN=
# DEEPSEEK_API_KEY=
